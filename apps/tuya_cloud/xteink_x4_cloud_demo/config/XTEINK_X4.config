CONFIG_BOARD_CHOICE_ESP32=y
CONFIG_BOARD_CHOICE_XTEINK_X4=y
CONFIG_PLATFORM_FLASHSIZE_16M=y
# CONFIG_PLATFORM_FLASHSIZE_4M is not set

# Display + cloud: lightweight 1bpp gfx (no LVGL heap)
# CONFIG_ENABLE_PLATFORM_LVGL is not set
# CONFIG_ENABLE_LIBLVGL is not set
# CONFIG_ENABLE_LVGL_DEMO is not set
# CONFIG_LVGL_ENABLE_TP is not set

# Trim AI service (not used by this demo)
# CONFIG_ENABLE_AI_MONITOR is not set
# CONFIG_ENABLE_TUYA_CODEC is not set
CONFIG_AI_INPUT_RINGBUF_SIZE=4096
CONFIG_AI_OUTPUT_RINGBUF_SIZE=4096
CONFIG_AI_INPUT_BUF_SIZE=1024
CONFIG_AI_OUTPUT_BUF_SIZE=1024
CONFIG_AI_MAX_FRAGMENT_LENGTH=2048
CONFIG_AI_WRITE_SOCKET_BUF_SIZE=1024

# Smaller mbedTLS I/O buffers for ESP32-C3 heap headroom
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=1024

# BLE stack (netcfg only)
CONFIG_TUYA_HS_BLE_HOST_STACK_SIZE=4096

# Smaller system queues on ESP32-C3
CONFIG_STACK_SIZE_WORK_QUEUE=3072
CONFIG_MAX_NODE_NUM_WORK_QUEUE=32
CONFIG_STACK_SIZE_TIMERQ=4096

CONFIG_VFS_SUPPORT_IO=y
CONFIG_VFS_SUPPORT_DIR=y
