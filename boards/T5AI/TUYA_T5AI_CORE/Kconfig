config CHIP_CHOICE
    string
    default "T5AI"

config BOARD_CHOICE
    string
    default "TUYA_T5AI_CORE"

config BOARD_CONFIG
    bool
    default y
    select ENABLE_AUDIO_CODECS
    select ENABLE_AUDIO_AEC
    select ENABLE_LED
    select ENABLE_BUTTON

choice TUYA_T5AI_CORE_EX_MODULE
    prompt "choose expansion module for TUYA_T5AI_CORE"
    default TUYA_T5AI_CORE_EX_MODULE_NONE

    config TUYA_T5AI_CORE_EX_MODULE_NONE
        bool "no expansion module"

    config TUYA_T5AI_CORE_EX_MODULE_13565LCD
        bool "1.54 inch 240x240 spi LCD"
        select ENABLE_DISPLAY

    config TUYA_T5AI_CORE_EX_MODULE_ST7735S_XLT
        bool "ST7735S XLT 160x80 spi LCD"
        select ENABLE_DISPLAY
endchoice
